# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Redis (Phase 0)
REDIS_URL=redis://redis:6379/0

# Resilience defaults (Phase 0) — see app/core/resilience.py
HTTP_DEFAULT_TIMEOUT_SECONDS=10
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30

# --- Added in later phases, listed here now so nothing is a surprise later ---
# Phase 1 (Auth & Tenancy): FIREBASE_PROJECT_ID, GOOGLE_APPLICATION_CREDENTIALS
# Phase 3 (Agent Core):      ANTHROPIC_API_KEY, OPENAI_API_KEY (one per provider adapter)
# Phase 4 (Sandbox):          E2B_API_KEY
# Phase 6 (Billing):          STRIPE_API_KEY, STRIPE_WEBHOOK_SECRET
